# Email settings
EMAIL__IMAP_HOST=imap.gmail.com
EMAIL__IMAP_PORT=993
EMAIL__IMAP_USERNAME=your_email@gmail.com
EMAIL__IMAP_APP_PASSWORD=your_app_password
EMAIL__MAILBOX=INBOX
EMAIL__DAYS_BACK=7
EMAIL__MAX_EMAILS=50

# Runtime settings
RUN__LOG_LEVEL=INFO
RUN__OUTPUT_DIR=outputs

# Gmail API settings (paths are relative to GMAIL__BASE_DIR, or the working directory if unset)
# GMAIL__BASE_DIR=/absolute/path/to/email-summarizer
GMAIL__CLIENT_SECRET_FILE=secrets/credentials.json
GMAIL__TOKEN_PATH=secrets/token.json
GMAIL__STATE_PATH=data/state/gmail_sync.json
GMAIL__RAW_OUTPUT_DIR=data/raw
# Exact sender addresses only, comma-separated
GMAIL__NEWSLETTER_SENDERS=newsletter@example.com,digest@example.org
GMAIL__DAYS_BACK=7
GMAIL__MAX_RESULTS=100
GMAIL__MAX_RETRIES=3
